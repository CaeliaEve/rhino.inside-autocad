				<Command Local="GH8" Global="GH8" />
				<Command Local="SWITCH_RHINO_VERSION" Global="SWITCH_RHINO_VERSION" />
				<Command Local="TOGGLE_RHINO_PREVIEW" Global="TOGGLE_RHINO_PREVIEW" />
				<Command Local="OPEN_RHINO_VIEWPORT" Global="OPEN_RHINO_VIEWPORT" />
				<Command Local="GRASSHOPPER_PLAYER" Global="GRASSHOPPER_PLAYER" />
				<Command Local="GRASSHOPPER_TOGGLE_SOLVER" Global="GRASSHOPPER_TOGGLE_SOLVER" />
				<Command Local="GRASSHOPPER_PREVIEW_OFF" Global="GRASSHOPPER_PREVIEW_OFF" />
				<Command Local="GRASSHOPPER_PREVIEW_SHADED" Global="GRASSHOPPER_PREVIEW_SHADED" />
				<Command Local="GRASSHOPPER_PREVIEW_WIREFRAME" Global="GRASSHOPPER_PREVIEW_WIREFRAME" />
				<Command Local="GRASSHOPPER_RECOMPUTE" Global="GRASSHOPPER_RECOMPUTE" />
				<Command Local="RHINO_PACKAGE_MANGER" Global="RHINO_PACKAGE_MANGER" />
				<Command Local="RHINO_INSIDE_ABOUT" Global="RHINO_INSIDE_ABOUT" />
				<Command Local="RHINO_INSIDE_SUPPORT" Global="RHINO_INSIDE_SUPPORT" />
				<Command Local="RHINO_INSIDE_UPDATE" Global="RHINO_INSIDE_UPDATE" />
				<Command Local="RHINO_INSIDE_SETTINGS" Global="RHINO_INSIDE_SETTINGS" />
				<Command Local="RHINO_INSIDE_CONVERT_BREP" Global="RHINO_INSIDE_CONVERT_BREP" />
			</Commands>
		</ComponentEntry>

		<ComponentEntry AppName="Rhino.Inside.AutoCAD"
					  ModuleName="./Toolbar/RhinoInsideAutocad_Toolbar_NET48.cuix"
					  AppDescription="Toolbar"/>
	</Components>

