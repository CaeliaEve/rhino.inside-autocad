	<Components Description="Rhino Inside AutoCAD Components Net48">
		<RuntimeRequirements SupportPath="./Icons;./Icons/Small32;./Icons/Large512;./Toolbar;" OS="Win64" Platform="AutoCAD*" SeriesMin="R24.3" SeriesMax="R24.3"/>

		<ComponentEntry AppName="Rhino.Inside.AutoCAD"
						ModuleName="./1.3.1/Win64/NET48/Rhino.Inside.AutoCAD.Applications.dll"
						AppDescription="Rhino Inside AutoCAD Main Application"
						LoadOnAutoCADStartup="True"
						LoadOnCommandInvocation="True">
			<Commands GroupName="RHINOINSIDE_COMMANDS">
				<Command Local="RHINO" Global="RHINO" />
				<Command Local="RHINO7" Global="RHINO7" />
				<Command Local="RHINO8" Global="RHINO8" />
				<Command Local="GRASSHOPPER" Global="GRASSHOPPER" />
