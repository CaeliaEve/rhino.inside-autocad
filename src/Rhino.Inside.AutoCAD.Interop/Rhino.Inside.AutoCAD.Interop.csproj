<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(TargetFrameworkName)</TargetFramework>
		<Configurations>Release;Debug;ReleaseNET8;DebugNET8</Configurations>
		<ImplicitUsings>enable</ImplicitUsings>
		<OutputType>Library</OutputType>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<Version>$(AssemblyVersion)</Version>
		<Company>$(BimorphCompany)</Company>
		<Product>$(BimorphProduct)</Product>
		<Copyright>$(BimorphCopyright)</Copyright>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<ProduceReferenceAssembly>True</ProduceReferenceAssembly>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<ItemGroup>

		<PackageReference Include="NaturalSort.Extension" />
		<PackageReference Include="MaterialDesignThemes" />
		<PackageReference Include="Microsoft.Bcl.HashCode" />
		<PackageReference Include="AutoCAD.NET.Model">
		<ExcludeAssets>runtime</ExcludeAssets>
	</PackageReference>

		<PackageReference Include="RhinoCommon">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="RhinoWindows">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Grasshopper">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="AutoCAD.NET">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="AutoCAD.NET.Core">
			<PrivateAssets></PrivateAssets>
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
	

	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Rhino.Inside.AutoCAD.Core\Rhino.Inside.AutoCAD.Core.csproj">
		  <Private>False</Private>
		  <ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
		<ProjectReference Include="..\Rhino.Inside.AutoCAD.Services\Rhino.Inside.AutoCAD.Services.csproj">
		  <Private>False</Private>
		  <ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
		<ProjectReference Include="..\Rhino.Inside.AutoCAD.UI.Resources\Rhino.Inside.AutoCAD.UI.Resources.csproj">
		  <Private>False</Private>
		  <ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Autocad\Scale\" />
	</ItemGroup>

	<!-- WCF client assemblies for LAN Zoo licensing on .NET 8 hosts. AutoCAD ships only
	     System.ServiceModel.Primitives (6.0 in 2025, 8.0 and 8.1 in 2026), so the matching
	     HTTP transport is shipped with the plugin and resolved at runtime by RhinoCoreExtension. -->
	<ItemGroup Condition="'$(Configuration)' == 'DebugNET8' Or '$(Configuration)' == 'ReleaseNET8'">
	  <None Include="WCF\System.ServiceModel.dll" CopyToOutputDirectory="PreserveNewest" Link="System.ServiceModel.dll" />
	  <None Include="WCF\System.ServiceModel.Http.6.0.dll" CopyToOutputDirectory="PreserveNewest" Link="System.ServiceModel.Http.6.0.dll" />
	  <None Include="WCF\System.ServiceModel.Primitives.6.0.dll" CopyToOutputDirectory="PreserveNewest" Link="System.ServiceModel.Primitives.6.0.dll" />
	  <None Include="WCF\System.ServiceModel.Http.8.0.dll" CopyToOutputDirectory="PreserveNewest" Link="System.ServiceModel.Http.8.0.dll" />
	  <None Include="WCF\System.ServiceModel.Primitives.8.0.dll" CopyToOutputDirectory="PreserveNewest" Link="System.ServiceModel.Primitives.8.0.dll" />
	  <None Include="WCF\System.ServiceModel.Http.8.1.dll" CopyToOutputDirectory="PreserveNewest" Link="System.ServiceModel.Http.8.1.dll" />
	  <None Include="WCF\System.ServiceModel.Primitives.8.1.dll" CopyToOutputDirectory="PreserveNewest" Link="System.ServiceModel.Primitives.8.1.dll" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'DebugNET8'">
		<DefineConstants>DEBUG;DEBUGNET8;TRACE</DefineConstants>
		<Optimize>false</Optimize>
		<DebugType>full</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>


	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="xcopy /y /i &quot;$(OutDir)*.dll&quot; &quot;$(AppRootDirAssemblies)&quot;&#xD;&#xA;xcopy /y /i &quot;$(OutDir)*.pdb&quot; &quot;$(AppRootDirAssemblies)&quot;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;xcopy /y /i &quot;$(OutDir)*.dll&quot; &quot;$(DeploymentPackage_Win64)&quot;" />
	</Target>

</Project>
