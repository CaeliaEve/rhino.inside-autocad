<Window x:Class="Rhino.Inside.AutoCAD.UI.Resources.Views.RhinoVersionDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Select Rhino Version"
        Height="440"
        Width="520"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="Maison Neue"
        MouseDown="Window_MouseDown"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Rhino.Inside.AutoCAD.UI.Resources;component/Views/Styles/ColorStyles.xaml" />

                <materialDesign:CustomColorTheme BaseTheme="Light"
                                                 PrimaryColor="{StaticResource BrandBlue}"
                                                 SecondaryColor="{StaticResource BrandGrey}" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/materialdesign3.defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundCardBrush}">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Explanation -->
            <RowDefinition Height="Auto" />
            <!-- Version list -->
            <RowDefinition Height="*" />
            <!-- Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="20,20,20,0">

            <Image Source="pack://application:,,,/Rhino.Inside.AutoCAD.UI.Resources;component/Resources/RhinoInsideLogo.png"
                   Margin="0,0,10,0"
                   Width="48"
                   VerticalAlignment="Center" />

            <TextBlock Text="Select a Rhino version"
                       VerticalAlignment="Center"
                       FontSize="20"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Style="{StaticResource MaterialDesignBodyLargeTextBlock}" />
        </StackPanel>

        <!-- Explanation -->
        <TextBlock Grid.Row="1"
                   Text="More than one version of Rhino is installed on this machine. Choose the version Rhino.Inside.AutoCAD should use in this session."
                   TextWrapping="Wrap"
                   Margin="20,14,20,0"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   Style="{StaticResource MaterialDesignBodyMediumTextBlock}" />

        <!-- Version list -->
        <Border Grid.Row="2"
                BorderThickness="0.5"
                BorderBrush="{StaticResource BorderGreyColorBrush}"
                Margin="20,14,20,0">

            <ListBox ItemsSource="{Binding Installations}"
                     SelectedItem="{Binding SelectedInstallation}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Style="{StaticResource MaterialDesignBodyMediumTextBlock}" />

                            <TextBlock Text="{Binding SystemDirectory}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SystemDirectory}"
                                       FontSize="10"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="20,14,20,20">

            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="Cancel"
                    BorderThickness="2"
                    Padding="15,5"
                    Margin="0,0,10,0"
                    BorderBrush="{StaticResource SecondaryTextBrush}"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Command="{Binding CancelCommand}" />

            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="{Binding AlwaysUseButtonText}"
                    BorderThickness="2"
                    Padding="15,5"
                    Margin="0,0,10,0"
                    BorderBrush="{StaticResource PrimaryTextBrush}"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Command="{Binding AlwaysUseCommand}" />

            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="{Binding UseButtonText}"
                    BorderThickness="2"
                    Padding="15,5"
                    IsDefault="True"
                    BorderBrush="{StaticResource PrimaryColorBrush}"
                    Foreground="{StaticResource PrimaryColorBrush}"
                    Command="{Binding UseCommand}" />
        </StackPanel>
    </Grid>
</Window>
