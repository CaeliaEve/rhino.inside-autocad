<Window x:Class="Rhino.Inside.AutoCAD.UI.Resources.Views.ExpirationDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="ExpirationDialogWindow"
        Height="600"
        Width="500"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        WindowStyle="None"
        ResizeMode="NoResize"
        FontFamily="Maison Neue"
        MouseDown="Window_MouseDown"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Rhino.Inside.AutoCAD.UI.Resources;component/Views/Styles/ColorStyles.xaml" />

                <materialDesign:CustomColorTheme BaseTheme="Light"
                                                 PrimaryColor="{StaticResource BrandBlue}"
                                                 SecondaryColor="{StaticResource BrandGrey}" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/materialdesign3.defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundCardBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- The Alert icon - always visible for expiration dialog -->
        <materialDesign:PackIcon Kind="Alert"
                                 Grid.Row="0"
                                 Grid.Column="0"
                                 Margin="20,20,10,0"
                                 Foreground="{StaticResource WarningColorBrush}"
                                 HorizontalAlignment="Left"
                                 Visibility="Visible" />

        <!-- The Rhino Inside Logo -->
        <Image Grid.Row="0"
               Grid.Column="1"
               Source="pack://application:,,,/Rhino.Inside.AutoCAD.UI.Resources;component/Resources/RhinoInsideLogo.png"
               Margin="20"
               Width="92"
               VerticalAlignment="Top"
               HorizontalAlignment="Right"
               Grid.RowSpan="2" />


        <!-- The expiration message TextBlock -->
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   MaxWidth="560"
                   MaxHeight="80"
                   VerticalAlignment="Top"
                   Foreground="{StaticResource WarningColorBrush}"
                   Text="{Binding ExpirationMessage}"
                   Margin="20,45,20,5"
                   TextAlignment="Left"
                   TextWrapping="Wrap"
                   FontSize="12"
                   FontWeight="Medium" />

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,10,0,15">

            <!-- Download Update Button -->
            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="Download Update"
                    BorderThickness="2"
                    Margin="0,0,15,0"
                    Padding="15,5"
                    BorderBrush="{StaticResource PrimaryColorBrush}"
                    Foreground="{StaticResource PrimaryColorBrush}"
                    Click="DownloadButton_Click" />

            <!-- Close Button -->
            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="Close"
                    BorderThickness="2"
                    Padding="15,5"
                    BorderBrush="{StaticResource WarningColorBrush}"
                    Foreground="{StaticResource WarningColorBrush}"
                    Click="CloseButton_Click" />
        </StackPanel>


        <!-- App Version Label -->
        <TextBlock Grid.Column="0"
                   Grid.Row="2"
                   Margin="20,5,0,5"
                   Text="{Binding AppVersion}"
                   HorizontalAlignment="Left"
                   FontWeight="Regular"
                   FontSize="10"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   VerticalAlignment="Center" />


        <!-- The copyright Label -->
        <TextBlock Grid.Column="0"
                   Grid.Row="3"
                   Text="{Binding CopyrightNotice}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   FontSize="10"
                   FontWeight="Regular"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Margin="20,5,0,10" />


        <!-- The Rhino Inside Logo -->
        <Image Grid.Row="4"
               Grid.Column="0"
               Source="pack://application:,,,/Rhino.Inside.AutoCAD.UI.Resources;component/Resources/Rhino_Full_Logo.png"
               Height="64"
               Margin="10 0"
               VerticalAlignment="Top"
               HorizontalAlignment="Left"/>


        <!-- Brought to you Label -->
        <StackPanel Grid.Row="6"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,8,0,8">
            <TextBlock Text="Developed in collaboration with"
                       FontStyle="Italic"
                       HorizontalAlignment="Center"
                       FontSize="10"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       VerticalAlignment="Center" />

            <Image Source="pack://application:,,,/Rhino.Inside.AutoCAD.UI.Resources;component/Resources/BimorphLogo.png"
                   Width="70"
                   Margin="8 0 0 0"
                   VerticalAlignment="Center" />
        </StackPanel>


       
    </Grid>
</Window>
